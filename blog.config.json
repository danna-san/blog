{
  "site": {
    "title": "だんなさんの日々",
    "description": "なんでもない毎日のこと。",
    "author": "danna-san",
    "baseUrl": "https://danna-san.github.io/blog",
    "language": "ja"
  },
  "publish": {
    "timezone": "Asia/Tokyo",
    "dayStartHour": 4,
    "allowedAuthors": [],
    "publishedLabel": "published",
    "skipLabels": ["draft", "no-blog"],
    "systemLabels": ["published", "draft", "no-blog"],
    "lookbackDays": 14
  },
  "ai": {
    "provider": "claude-code",
    "model": "",
    "rewriteLevel": "medium",
    "sampleMaxChars": 6000,
    "fallback": {
      "provider": "github-models",
      "model": "openai/gpt-4.1",
      "temperature": 0.8,
      "lintRetries": 1
    }
  },
  "images": {
    "maxWidth": 1600,
    "quality": 82,
    "maxVideoMB": 25
  },
  "ui": {
    "headerTagCount": 12,
    "indexPostCount": 10,
    "feedPostCount": 20
  }
}
